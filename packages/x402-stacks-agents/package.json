{
  "name": "@aibtc/x402-stacks-agents",
  "version": "0.1.0",
  "description": "Stacks (sBTC/STX/USDCx) x402 payments for Cloudflare's Agents SDK, built on x402-stacks",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aibtcdev/cloudflare-agents-x402.git",
    "directory": "packages/x402-stacks-agents"
  },
  "homepage": "https://github.com/aibtcdev/cloudflare-agents-x402/tree/main/packages/x402-stacks-agents#readme",
  "bugs": "https://github.com/aibtcdev/cloudflare-agents-x402/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stacks/transactions": "^7.6.0",
    "x402-stacks": "^2.1.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
